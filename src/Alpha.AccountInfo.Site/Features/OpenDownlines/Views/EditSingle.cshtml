@model OpenSingleViewModel

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/Features/OpenDownlines/Bundles/open-single")
}

@Html.AntiForgeryToken()
@Html.Hidden("NotAuthorized", Resources.NotAuthorized)

<div id="container" class="unsuspend-container" />

@section Scripts {
    @StaticResources.RenderScripts("~/Features/OpenDownlines/Bundles/open-single")

    <script>
        renderOpenSingle(
            @Html.Raw(JsonConvert.SerializeObject(Model.Data, Newtonsoft.Json.Formatting.Indented)),
            @Html.Raw(Model.Resources));
    </script>
}