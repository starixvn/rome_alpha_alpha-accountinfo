@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model GivenCreditViewModel

@section Styles {
    @StaticResources.RenderStyles("~/Features/SearchAccount/Bundles/given-credit")
}

@Html.AntiForgeryToken()
@Html.Hidden("NotAuthorized", Resources.NotAuthorized)

<div id="given-credit" class="given-credit" />

@section Scripts {
    @StaticResources.RenderScripts("~/Features/SearchAccount/Bundles/given-credit")
    <script>
        renderGivenCredit(
            "@Model.SearchAccountId",
            "@Model.SearchAccountRoleId",
            "@Model.CurrentGivenCredit",
            "@Model.GivenCreditMin",
            "@Model.GivenCreditMax",
            @Html.Raw(Model.GivenCreditResources));
    </script>
}