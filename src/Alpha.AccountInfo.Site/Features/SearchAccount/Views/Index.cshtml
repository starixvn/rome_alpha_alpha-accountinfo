@{
	Layout = "~/Features/Shared/Views/_Layout.cshtml";
	string pattern = @"([a-zA-Z]+) (\d+)";

}
@model AccountInfoViewModel

@section Styles {
    @StaticResources.RenderStyles("/assets/bundles/common/common-" + Model.ActorLevel)
    @StaticResources.RenderStyles("~/Features/SearchAccount/Bundles/index")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/SearchAccount/Bundles/account-info-mobile-calculate-07")
}

<div id="account-info" />

@Html.AntiForgeryToken()

@section Scripts {
    @StaticResources.RenderScripts("~/Features/SearchAccount/Bundles/index")
    <script src="https://cdn.ravenjs.com/3.26.4/raven.min.js"
            crossorigin="anonymous"></script>

    <script>
        Raven.config('http://21a8f21f7c5a4cc1b9c79bb68fb0ebb9@sentry.nexdev.net/3').install();
        var accountInfoSiteAppPath = '@Model.AccountInfoUrl';
        var __RequestVerificationToken = $("input[name=\"__RequestVerificationToken\"]").val();
		var _assetCommonCssLink = '@StaticResources.AssetStyles.RenderCommon("/bundles/common/common")'
        renderAccountInfo(
            '@Model.SearchAccountName',
            '@Model.ActorRoleId',
            '@Model.ActoreName',
            JSON.parse('@Model.MobileView'.toLowerCase()),
			JSON.parse('@Model.ShowLoginInfo'.toLowerCase()),
			@Html.Raw(Model.AccountInfoResources)
        );
    </script>
}