@{
	Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model UnsuspendListViewModel

@section Styles {
	@StaticResources.RenderStyles("/assets/bundles/common/common-super")
	@StaticResources.RenderStyles("~/Features/SearchAccount/Bundles/index")
	@StaticResources.RenderStylesWithMedia(767, "~/Features/SearchAccount/Bundles/account-info-mobile-calculate-07")}

<div id="unsuspend-list" />

@Html.AntiForgeryToken()

@section Scripts {
	@StaticResources.RenderScripts("~/Features/UnsuspendDownlines/Bundles/unspend-view-list")

	<script>
        var __RequestVerificationToken = $("input[name=\"__RequestVerificationToken\"]").val();

        renderUnsuspendViewList(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model,
Newtonsoft.Json.Formatting.Indented)));
	</script>
}