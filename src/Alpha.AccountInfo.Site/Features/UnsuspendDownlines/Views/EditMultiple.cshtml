@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model UnsuspendMultipleViewModel

@section Styles {
    @StaticResources.RenderStyles($"~/Features/UnsuspendDownlines/Bundles/unsuspend-multiple{ViewData["DarkModeName"]}")
}

@Html.AntiForgeryToken()
@Html.Hidden("NotAuthorized", Resources.NotAuthorized)

<div id="container" class="unsuspend-container" />

@section Scripts {
    @StaticResources.RenderScripts("~/Features/UnsuspendDownlines/Bundles/unsuspend-multiple")

    <script>
        renderUnsuspendMultipe(
            @Html.Raw(JsonConvert.SerializeObject(Model, Newtonsoft.Json.Formatting.Indented)),
            @Html.Raw(Model.Resources));
    </script>
}