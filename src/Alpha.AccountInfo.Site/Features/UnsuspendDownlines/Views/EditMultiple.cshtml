@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model UnsuspendMultipleViewModel

@section Styles {
    @StaticResources.RenderStyles("~/Features/UnsuspendDownlines/Bundles/unspend-view-list")
}

<div id="container" class="unsuspend-container" />

@Html.AntiForgeryToken()

@section Scripts {
    @StaticResources.RenderScripts("~/Features/UnsuspendDownlines/Bundles/unsuspend-multiple")

    <script>
        var __RequestVerificationToken = $("input[name=\"__RequestVerificationToken\"]").val();

        renderUnsuspendMultipe(
            @Html.Raw(JsonConvert.SerializeObject(Model.Data, Newtonsoft.Json.Formatting.Indented)),
            @Html.Raw(Model.Resources));
    </script>
}