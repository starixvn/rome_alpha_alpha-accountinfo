@model IEnumerable<string>
@{
    /**/

    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    var imagesLibrary = JsonConvert.SerializeObject(Model);
}
@section Styles {
    @StaticResources.RenderStyles("~/Features/ProfilePicture/Bundles/picture-library")

}

<div id="root"></div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/ProfilePicture/Bundles/picture-library")

    <script>
        renderApp(@Html.Raw(imagesLibrary));
    </script>
}
