@model ProfielPictureViewModel

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    var imagesLibrary = JsonConvert.SerializeObject(Model.Images);
    var defaultAvatarUrl = Url.Content("~/Features/ProfilePicture/Styles/Images/icon_user_default.png");
}

@section Styles {
    @StaticResources.AssetStyles.Render($"/bundles/site-accountinfo/profilepicture/profilepicture-super")
    @StaticResources.RenderStyles("~/Features/ProfilePicture/Bundles/index")
}

@Html.AntiForgeryToken()
<div id="root"></div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/ProfilePicture/Bundles/index")

    <script>
        renderApp(
            @Html.Raw(imagesLibrary),
            '@defaultAvatarUrl',
            @Html.Raw(Model.Resources),
            '@Model.SetUpOTPLink',
            JSON.parse('@Model.AllowUpdate'.toLowerCase()),);
    </script>
}
