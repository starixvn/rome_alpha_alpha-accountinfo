@model IEnumerable<DefaultProfielPictureViewModel>

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    var imagesLibrary = JsonConvert.SerializeObject(Model);
}

@section Styles {
    @StaticResources.RenderStyles("~/Features/ProfilePicture/Bundles/index")
}

<div id="root"></div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/ProfilePicture/Bundles/index")

    <script>
        renderApp(@Html.Raw(imagesLibrary));
    </script>
}
