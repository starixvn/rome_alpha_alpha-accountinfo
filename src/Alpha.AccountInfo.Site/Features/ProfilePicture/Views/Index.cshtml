@model ProfielPictureViewModel

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    var imagesLibrary = JsonConvert.SerializeObject(Model.Images);
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/site-accountinfo/profilepicture/profilepicture-{Model.ActorLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/Features/ProfilePicture/Bundles/index")
}

@Html.AntiForgeryToken()
<div id="root"></div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/ProfilePicture/Bundles/index")

<script>
        renderApp(
            @Html.Raw(imagesLibrary),
            @Html.Raw(Model.Resources),
            '@Model.SetUpOTPLink',
            '@Model.ProtectionCodeLink',
            JSON.parse('@Model.AllowUpdate'.toLowerCase()),
            '@Model.ChangePasswordLink',
            '@Model.SecurityCodeLink',
            JSON.parse('@Model.EnableSecurityCode'.toLowerCase()),
            JSON.parse('@Model.IsOfferProtectedMode'.toLowerCase()),
            '@Model.DisplayLanguage',
            @Html.Raw(JsonConvert.SerializeObject(Model.Languages, Newtonsoft.Json.Formatting.None)),
            JSON.parse('@Model.AllowUpdateDisplayLanguage'.toLowerCase()));
</script>
}
