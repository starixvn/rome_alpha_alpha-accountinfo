@model ProfielPictureViewModel

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    var imagesLibrary = JsonConvert.SerializeObject(Model.Images);
    var darkModeName = ViewData["DarkModeName"];
}

@section Styles {
    @StaticResources.AssetStyles.Render($"/bundles/site-accountinfo/profilepicture/profilepicture-{Model.ActorLevel}{darkModeName}")
    @StaticResources.RenderStyles($"~/Features/ProfilePicture/Bundles/index{darkModeName}")
}

@Html.AntiForgeryToken()
<div id="root"></div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/ProfilePicture/Bundles/index")

    <script>
        renderApp(
            @Html.Raw(imagesLibrary),
            @Html.Raw(Model.Resources),
            '@Model.SetUpOTPLink',
            '@Model.ProtectionCodeLink',
            JSON.parse('@Model.AllowUpdate'.toLowerCase()),);
    </script>
}
