<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="SearchAccountId"
  custIdJsonParamNameMapping="SearchAccountId,CustIds"
  custIdsQueryStringParamNameMapping="CustIds"
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="2.11.01" permission="[B]" mainfuncname="Account Info" subfuncname="Update Suspended/Closed/Auto Master PT/Outright/Double Comm status" url="SearchAccount/UpdateCustomerStatus" ischeckbelonging="true" />
      <add id="2.11.02" permission="[B]" mainfuncname="Account Info" subfuncname="Update Product Status" url="ProductStatus/Update" ischeckbelonging="true" />
      <add id="2.11.03" permission="[B]" mainfuncname="Account Info" subfuncname="Update Credit Balance" url="SearchAccount/UpdateGivenCredit" ischeckbelonging="true" />      
      <add id="2.11.04" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Account Information Left Toolbox" url="SearchAccount/Index" ischeckbelonging="true" />
      <add id="2.11.05" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Customer Info" url="SearchAccount/GetCustomerInfo" ischeckbelonging="true" />
      <add id="2.11.06" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Online List" url="SearchAccount/GetOnlineList" ischeckbelonging="true" />
      <add id="2.11.07" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Customer all status" url="SearchAccount/GetCustomerAllStatus" ischeckbelonging="true" />
      <add id="2.11.08" permission="[H]" mainfuncname="Account Info" subfuncname="Downline list" url="SearchAccount/GetDownlineList" ischeckbelonging="true" />
      <add id="2.11.09" permission="[B]" mainfuncname="Account Info" subfuncname="Unsuspend Customer" url="UnsuspendDownlines/UnsuspendSingle" ischeckbelonging="true" />
      <add id="2.11.10" permission="[B]" mainfuncname="Account Info" subfuncname="Unsuspend Customer" url="UnsuspendDownlines/UnsuspendMultiple" ischeckbelonging="true" />
      <add id="2.11.11" permission="[B]" mainfuncname="Account Info" subfuncname="Unsuspend Customer" url="UnsuspendDownlines/EditMultiple" ischeckbelonging="true" />
      <add id="2.11.12" permission="[B]" mainfuncname="Account Info" subfuncname="Unsuspend Customer" url="UnsuspendDownlines/FetchCustomerList" ischeckbelonging="true" />
      <add id="2.11.13" permission="[B]" mainfuncname="Account Info" subfuncname="Update Credit Balance" url="SearchAccount/GivenCredit" ischeckbelonging="true" />
      <add id="2.12.01" permission="[B]" mainfuncname="Account Info" subfuncname="Open Customer" url="OpenDownlines/OpenSingle" ischeckbelonging="true" />
      <add id="2.12.02" permission="[B]" mainfuncname="Account Info" subfuncname="Open Customer" url="OpenDownlines/OpenMultiple" ischeckbelonging="true" />
      <add id="2.12.03" permission="[B]" mainfuncname="Account Info" subfuncname="Update Customer" url="OpenDownlines/EditMultiple" ischeckbelonging="true" />
      <add id="2.12.04" permission="[B]" mainfuncname="Account Info" subfuncname="Update Customer" url="OpenDownlines/FetchCustomerList" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>
  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>