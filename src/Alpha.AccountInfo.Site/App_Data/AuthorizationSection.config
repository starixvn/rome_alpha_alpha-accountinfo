<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="SearchAccountRoleId"
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="2.11.01" permission="[B]" mainfuncname="Account Info" subfuncname="Update Suspended/Closed/Auto Master PT/Outright/Double Comm status" url="AccountInfo/UpdateCustomerStatus" ischeckbelonging="true" />
      <add id="2.11.02" permission="[B]" mainfuncname="Account Info" subfuncname="Update Product Status" url="ProductStatus/Update" ischeckbelonging="true" />
      <add id="2.11.03" permission="[B]" mainfuncname="Account Info" subfuncname="Update Credit Balance" url="ProductStatus/UpdateGivenCredit" ischeckbelonging="true" />
      <add id="2.11.04" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Account Information Left Toolbox" url="AccountInfo/Index" ischeckbelonging="true"/>
      <add id="2.11.05" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Customer Info" url="AccountInfo/GetCustomerInfo" ischeckbelonging="true"/>
      <add id="2.11.06" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Online List" url="AccountInfo/GetOnlineList" ischeckbelonging="true"/>
      <add id="2.11.07" permission="[A],[B],[C],[D],[E],[F],[G],[H]" mainfuncname="Account Info" subfuncname="Customer all status" url="AccountInfo/GetCustomerAllStatus" ischeckbelonging="true"/>
      <add id="2.11.08" permission="[H]" mainfuncname="Member Info" subfuncname="Downline list" url="AccountInfo/GetDownlineList" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>
  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>

