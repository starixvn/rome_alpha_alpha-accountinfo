@model AccountInfoViewModel
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    @section Styles {
        @StaticResources.RenderStyles("/assets/bundles/common/common")
        @StaticResources.RenderStyles("/assets/bundles/common/common-" + Model.ActorLevelName)
        @StaticResources.RenderStyles("/assets/bundles/site-accountinfo/index")
        @StaticResources.RenderStyles("~/assets/bundles/account-info/index")
    }
</head>
<body>
    <div id="account-info">
    </div>
</body>
</html>
@StaticResources.RenderScripts("~/node_modules/react/dist/react")
@StaticResources.RenderScripts("~/node_modules/react-dom/dist/react-dom")
@StaticResources.RenderScripts("~/assets/bundles/account-info/index")
<script>
    var accountInfoSiteAppPath = '@Model.AccountInfoSiteAppPath';
    renderAccountInfo(JSON.parse('@Model.AccountInfoResources'.replace(/&quot;/g, '\"')))
</script>