@model AccountInfoViewModel
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    @section Styles {
        @StaticResources.RenderStyles("/assets/bundles/common/common-" + Model.ActorLevel)
        @StaticResources.RenderStyles("/assets/bundles/site-accountinfo/index")
        @StaticResources.RenderStyles("~/assets/bundles/account-info/index")
        @StaticResources.RenderStylesWithMedia(767, "~/assets/bundles/styles/account-info-mobile-calculate-07")
    }
</head>
<body>
    <div id="account-info" />
    @Html.AntiForgeryToken()
</body>
</html>
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/account-info/index")

    <script>
        var accountInfoSiteAppPath = '@Model.AccountInfoUrl';
        var __RequestVerificationToken = $("input[name=\"__RequestVerificationToken\"]").val();

        renderAccountInfo(
            '@Model.SearchAccountName',
            '@Model.ActorRoleId',
            '@Model.ActoreName',
            JSON.parse('@Model.MobileView'.toLowerCase()),
            JSON.parse('@Model.AccountInfoResources'.replace(/&quot;/g, '\"'))
        );
    </script>
}

