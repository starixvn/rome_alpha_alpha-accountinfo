@model AccountInfoViewModel
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    @section Styles {
        @StaticResources.RenderStyles("/assets/bundles/common/common-" + Model.ActorLevel)
        @StaticResources.RenderStyles("/assets/bundles/site-accountinfo/index")
        @StaticResources.RenderStyles("~/assets/bundles/account-info/index")
        <link rel='stylesheet' href='/site-accountinfo/assets/styles/account-info-mobile-calculate-07.css' type='text/css' media='screen and (max-device-width: 767px)' />
    }
</head>
<body>
    <div id="account-info"></div>
</body>
</html>
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/account-info/index")

    <script>
        var accountInfoSiteAppPath = '@Model.AccountInfoUrl';
        if (localStorage.getItem("actorName") !== '@Model.ActoreName') {
            localStorage.setItem('actorName', '@Model.ActoreName');
            localStorage.removeItem('lastSearchUsername');
        }
        renderAccountInfo(JSON.parse('@Model.AccountInfoResources'.replace(/&quot;/g, '\"')));
    </script>
}

