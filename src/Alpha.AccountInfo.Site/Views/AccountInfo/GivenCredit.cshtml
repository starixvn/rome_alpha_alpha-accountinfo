@model GivenCreditViewModel

<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    @section Styles {
        @StaticResources.RenderStyles("~/assets/bundles/account-info/given-credit")
    }
</head>
<body>
    <div id="given-credit" class="given-credit" />
    @Html.AntiForgeryToken()
</body>
</html>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/account-info/given-credit")
    <script>
        var __RequestVerificationToken = $("input[name=\"__RequestVerificationToken\"]").val();
        var accountInfoSiteAppPath = '@Model.AccountInfoUrl';
        renderGivenCredit(
            "@Model.SearchAccountId",
            "@Model.SearchAccountRoleId",
            "@Model.CurrentGivenCredit",
            JSON.parse('@Model.GivenCreditResources'.replace(/&quot;/g, '\"')));
    </script>
}

