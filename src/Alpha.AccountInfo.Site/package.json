{
  "name": "vsreact",
  "version": "1.2.0",
  "description": "VS 2015 and React",
  "license": "MIT",
  "repository": "https://github.com/martijnboland/VSReact",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "paths": {
      "reactIdSwiper": [
        "node_modules/react-id-swiper/lib/index"
      ]
    }
  },
  "scripts": {
    "build-css": "node-sass-chokidar assets/styles/ -o assets/styles/",
    "watch-css": "npm run build-css && node-sass-chokidar assets/styles/ -o assets/styles/ --watch --recursive",
    "start": "webpack-dev-server --config webpack.config.js --hot --progress --colors --devtool source-map",
    "build-js": "webpack --config webpack.config.js --mode production --progress --profile --colors",
    "build": "npm-run-all build-css build-js",
    "prod": "webpack -p --env production"
  },
  "dependencies": {
    "axios": "^0.16.2",
    "classnames": "^2.2.5",
    "mobx": "^3.1.16",
    "mobx-react": "^4.2.1",
    "mobx-react-devtools": "^4.2.15",
    "react-dom": "^15.6.1",
    "react-hot-loader": "^3.0.0-beta.1",
    "node-sass-chokidar": "^1.3.0",
    "npm-run-all": "^4.1.3"
  },
  "devDependencies": {
    "@types/core-js": "^0.9.42",
    "@types/node": "^8.0.5",
    "@types/react": "^15.0.33",
    "@types/react-dom": "^15.5.1",
    "@types/swiper": "^4.2.0",
    "@types/webpack-env": "^1.13.0",
    "awesome-typescript-loader": "^3.2.1",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.5",
    "babel-preset-env": "^1.7.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-react-hot": "^1.0.5",
    "babel-preset-stage-1": "^6.24.1",
    "core-js": "^2.4.1",
    "css-loader": "^1.0.0",
    "html-webpack-plugin": "2.28.0",
    "mini-css-extract-plugin": "^0.4.1",
    "optimize-css-assets-webpack-plugin": "^4.0.3",
    "raw-loader": "^0.5.1",
    "react": "^15.6.2",
    "react-accessible-accordion": "^2.4.3",
    "react-id-swiper": "^1.6.6",
    "react-number-format": "^3.4.2",
    "source-map-loader": "^0.2.1",
    "style-loader": "^0.18.2",
    "swiper": "^4.3.3",
    "todomvc-app-css": "^2.1.0",
    "typescript": "^2.1.6",
    "webpack": "^4.10.2",
    "webpack-cli": "^2.1.5",
    "webpack-dev-server": "^3.1.3"
  }
}
