{
  "name": "account-info",
  "version": "1.0.0",
  "description": "Account Info Microsite",
  "license": "Nexcel Solution",
  "repository": "",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "paths": {}
  },
  "scripts": {
    "build-css": "node-sass-chokidar assets/styles/ -o assets/styles/",
    "watch-css": "npm run build-css && node-sass-chokidar assets/styles/ -o assets/styles/ --watch --recursive",
    "start": "webpack-dev-server --config webpack.config.js --hot --progress --colors --devtool source-map",
    "build-js": "webpack --config webpack.config.js --mode production --progress --profile --colors",
    "build": "npm run build-css && npm run build-js "
  },
  "dependencies": {
    "axios": "^0.16.2",
    "build-css": "^0.2.0",
    "build-js": "^1.0.0",
    "classnames": "^2.2.5",
    "node-sass-chokidar": "^1.3.0",
    "npm-run-all": "^4.1.3",
    "react-autosuggest": "^9.3.4",
    "react-hot-loader": "^3.0.0-beta.1"
  },
  "devDependencies": {
    "@types/core-js": "^0.9.42",
    "@types/node": "^8.0.5",
    "@types/webpack-env": "^1.13.0",
    "awesome-typescript-loader": "^3.2.1",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.5",
    "babel-preset-env": "^1.7.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-react-hot": "^1.0.5",
    "babel-preset-stage-1": "^6.24.1",
    "base64-js": "^1.3.0",
    "core-js": "^2.4.1",
    "css-loader": "^1.0.0",
    "html-webpack-plugin": "2.28.0",
    "install": "^0.12.1",
    "jquery": "^3.3.1",
    "mini-css-extract-plugin": "^0.4.1",
    "npm": "^6.4.1",
    "optimize-css-assets-webpack-plugin": "^4.0.3",
    "raw-loader": "^0.5.1",
    "react": "^16.5.1",
    "react-accessible-accordion": "^2.4.4",
    "react-dom": "^16.5.1",
    "react-number-format": "^3.4.2",
    "react-router": "^4.3.1",
    "react-router-dom": "^4.3.1",
    "react-router-drilldown": "^3.0.2",
    "react-tippy": "^1.2.2",
    "react-view-slider": "^3.0.6",
    "source-map-loader": "^0.2.1",
    "style-loader": "^0.18.2",
